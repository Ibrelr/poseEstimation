{
  "pose_config": {
    "model_complexity": 1,
    "smooth_landmarks": true,
    "enable_segmentation": false,
    "min_detection_confidence": 0.5,
    "min_tracking_confidence": 0.5,
    "max_num_poses": 1
  },
  "camera_config": {
    "width": 640,
    "height": 480,
    "fps": 30,
    "device_id": 0
  },
  "model_config": {
    "input_shape": 99,
    "num_classes": 5,
    "learning_rate": 0.001,
    "batch_size": 32,
    "epochs": 100
  },
  "activities": [
    "standing",
    "sitting", 
    "walking",
    "yoga_pose",
    "exercise"
  ],
  "gestures": {
    "arms_up": {
      "description": "Both arms raised above shoulders",
      "action": "open_browser_tab",
      "threshold": 0.8
    },
    "wave": {
      "description": "Horizontal arm movement",
      "action": "toggle_camera",
      "threshold": 0.7
    },
    "squat": {
      "description": "Bent knees, lowered position",
      "action": "toggle_fullscreen",
      "threshold": 0.6
    },
    "thumbs_up": {
      "description": "Thumb pointing upward",
      "action": "capture_image",
      "threshold": 0.8
    }
  },
  "visualization": {
    "landmark_color": "#00b894",
    "connection_color": "#3498db",
    "text_color": "#2c3e50",
    "confidence_threshold": 0.5
  },
  "performance": {
    "enable_gpu": true,
    "optimize_for_mobile": false,
    "max_fps": 30,
    "buffer_size": 10
  }
} 